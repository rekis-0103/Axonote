# ============================================================
# Axonote - root environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ============================================================

# ---- Database (MySQL 8.x) ----
# Local dev default: root user, empty password (per spec).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=axonote

# SQLAlchemy URL. Used by API + worker.
# MySQL:   mysql+pymysql://root:@localhost:3306/axonote
# SQLite (no-DB fallback for quick local dev): sqlite:///./axonote.dev.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/axonote

# ---- Auth / JWT ----
# Generate strong secrets in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520   # 20 MB
ALLOWED_EXTENSIONS=pdf,docx,pptx

# ---- Worker ----
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_BATCH_SIZE=1

# ---- Google Sign-In ----
# OAuth 2.0 Web client ID from Google Cloud Console (no client secret needed for ID-token flow).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
