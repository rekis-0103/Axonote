{
  "name": "axonote",
  "version": "0.1.0",
  "private": true,
  "description": "Axonote - material summarization & quiz practice (classic ML/NLP, no LLM).",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
